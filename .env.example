FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
MASTER_KEY=generate-with-fernet-see-setup-notes

# Database
DATABASE_URL=sqlite:///tjs_trading.db

# CoinMarketCap API (free) — coinmarketcap.com/api
CMC_API_KEY=your-cmc-key-here
CMC_CACHE_SECONDS=120
SCAN_LIMIT=10
MARKET_CAP_MIN=50000000

# Groq API (free) — console.groq.com
GROQ_API_KEY=your-groq-key-here

# Scheduler
AUTO_SCAN_ENABLED=true
AUTO_SCAN_INTERVAL_HOURS=6
